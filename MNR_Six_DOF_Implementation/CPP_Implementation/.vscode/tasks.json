{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Current CPP File",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/std:c++17",
                "/nologo",

                "/I${workspaceFolder}",
                "/I${workspaceFolder}/..",

                "${file}",
                "${workspaceFolder}/MNR_FK.cpp",
                "${workspaceFolder}/MNR_J.cpp",

                "/Fo${workspaceFolder}/build/",
                "/Fd${workspaceFolder}/build/${fileBasenameNoExtension}.pdb",
                "/Fe${workspaceFolder}/build/${fileBasenameNoExtension}.exe",

                "/link",
                "/INCREMENTAL:NO"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ]
        }
    ]
}